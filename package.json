{
  "name": "thoughts-from",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-views.mjs",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "express": "5.2.1",
    "pg": "8.23.0",
    "ventojs": "2.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
